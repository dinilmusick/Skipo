{
  "name": "skipo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Skipo — Application Builder, Installer & Composition Engine consuming @kloks/* and @floks/* packages",
  "bin": {
    "skipo": "./bin/skipo.js"
  },
  "scripts": {
    "build": "python3 scripts/skipo_builder.py validate-links && tsc --noEmit",
    "test": "python3 -m unittest checklists/test_19_skipo_frontend_structure.py && vitest run",
    "validate": "python3 scripts/skipo_builder.py validate-links && python3 checklists/full_system_validator.py .",
    "assistant": "python3 assistant.py",
    "skipo": "python3 scripts/skipo_builder.py",
    "typecheck": "tsc --noEmit",
    "validate:frnl": "python3 scripts/validate_frnl.py",
    "ecosystem": "python3 scripts/ecosystem_sync.py",
    "ecosystem:hydrate": "python3 scripts/ecosystem_sync.py hydrate all",
    "ecosystem:end-session": "python3 scripts/ecosystem_sync.py end-session",
    "ecosystem:cleanup": "python3 scripts/ecosystem_sync.py cleanup",
    "ecosystem:checkpoint": "python3 scripts/ecosystem_sync.py checkpoint"
  },
  "dependencies": {
    "@dinilmusick/gutts": "^0.1.3",
    "@ultrst-armada/floks": "^1.3.0",
    "@ultrst-armada/frnlts": "^0.2.7",
    "@ultrst-armada/kloks": "^1.7.0",
    "@ultrst-armada/krnl": "^1.0.7",
    "lucide-react": "^1.55.0",
    "p-queue": "^10.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.1.0"
  },
  "pnpm": {
    "overrides": {
      "bullmq": "6.3.16"
    }
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
