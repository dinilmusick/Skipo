{
  "name": "skipo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Skipo — Application Builder, Installer & Composition Engine consuming @kloks/* and @floks/* packages",
  "bin": {
    "skipo": "./bin/skipo.js"
  },
  "scripts": {
    "build": "python3 scripts/skipo_builder.py validate-links && tsc --noEmit",
    "test": "python3 -m pytest -q --import-mode=importlib checklists/test_19_skipo_frontend_structure.py tests/import_direction_governance.test.py tests/graph_application_contract.test.py tests/generate_graph_assets.test.py tests/generic_product_module_boundary.test.py tests/module-scaffold.test.py tests/module_architecture.test.py tests/external-interface-scaffold.test.py tests/storage_provider_contract.test.py tests/authentication_scaffold.test.py && python3 checklists/21_skipo_authentication_contract.py && node scripts/validate_luth_package_exports.mjs && vitest run",
    "validate": "python3 scripts/skipo_builder.py validate-links && python3 checklists/full_system_validator.py .",
    "assistant": "python3 assistant.py",
    "skipo": "python3 scripts/skipo_builder.py",
    "typecheck": "tsc --noEmit",
    "module:architecture": "python3 checklists/24_module_architecture.py .",
    "validate:frnl": "python3 scripts/validate_frnl.py",
    "ecosystem": "python3 scripts/ecosystem_sync.py",
    "ecosystem:hydrate": "python3 scripts/ecosystem_sync.py hydrate all",
    "ecosystem:end-session": "python3 scripts/ecosystem_sync.py end-session",
    "ecosystem:cleanup": "python3 scripts/ecosystem_sync.py cleanup",
    "ecosystem:checkpoint": "python3 scripts/ecosystem_sync.py checkpoint",
    "generate:graph-assets": "python3 scripts/skipo_builder.py generate-graph-assets",
    "boundary": "node scripts/architecture-boundary.mjs",
    "boundary:relative": "node scripts/relative-package-boundary.mjs",
    "boundary:application": "python3 -m pytest -q --import-mode=importlib tests/import_direction_governance.test.py tests/graph_application_contract.test.py"
  },
  "dependencies": {
    "@dinilmusick/gutts": "^2.0.3",
    "@ultrst-armada/floks": "^2.0.0",
    "@ultrst-armada/frnlts": "^0.5.23",
    "@ultrst-armada/kloks": "^1.26.5",
    "@ultrst-armada/krnl": "^1.0.25",
    "@xyflow/react": "^12.11.1",
    "d3-force": "^3.0.0",
    "lucide-react": "^0.553.0",
    "p-queue": "^10.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "vitest": "^3.1.0",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "overrides": {
      "bullmq": "6.3.16"
    },
    "onlyBuiltDependencies": [
      "@dinilmusick/gutts",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
}
