{
  "name": "@skipo/validate",
  "version": "1.0.0",
  "description": "Skipo Validate — AST-based code quality enforcement and ESLint plugin",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "skipo-validate": "./dist/cli/validate.js"
  },
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" },
    "./eslint": { "import": "./dist/eslint-plugin/index.js", "types": "./dist/eslint-plugin/index.d.ts" }
  },
  "scripts": {
    "build": "tsup src/index.ts src/eslint-plugin/index.ts src/cli/validate.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@skipo/core": "workspace:*",
    "ts-morph": "^24.0.0"
  },
  "peerDependencies": {
    "eslint": "^8.0.0 || ^9.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsup": "^8.4.0",
    "vitest": "^3.1.0",
    "eslint": "^9.0.0"
  }
}
