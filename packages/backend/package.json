{
  "name": "@skipo/backend",
  "version": "1.0.0",
  "description": "Skipo Backend — Auth, storage, workspace, control plane, and API infrastructure",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" },
    "./auth": { "import": "./dist/auth/index.js", "types": "./dist/auth/index.d.ts" },
    "./storage": { "import": "./dist/storage/index.js", "types": "./dist/storage/index.d.ts" },
    "./api": { "import": "./dist/api/index.js", "types": "./dist/api/index.d.ts" }
  },
  "scripts": {
    "build": "tsup src/index.ts src/auth/index.ts src/storage/index.ts src/api/index.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@skipo/core": "workspace:*"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.0.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-storage": "^3.600.0",
    "@supabase/supabase-js": "^2.45.0",
    "@neondatabase/serverless": "^0.10.0",
    "bcryptjs": "^2.4.3",
    "zod": "^3.22.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": { "optional": true },
    "@aws-sdk/client-s3": { "optional": true },
    "@aws-sdk/lib-storage": { "optional": true },
    "@supabase/supabase-js": { "optional": true },
    "@neondatabase/serverless": { "optional": true },
    "bcryptjs": { "optional": true },
    "zod": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsup": "^8.4.0",
    "vitest": "^3.1.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/bcryptjs": "^2.4.0"
  }
}
