{
  "name": "create-skipo",
  "version": "1.0.0",
  "description": "Interactive CLI scaffolder for Skipo apps (Next.js, React+Vite, Electron)",
  "type": "module",
  "bin": {
    "create-skipo": "./dist/index.js",
    "skipo": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@skipo/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsup": "^8.4.0",
    "@types/node": "^22.0.0"
  }
}
