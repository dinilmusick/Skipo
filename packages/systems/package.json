{
  "name": "@skipo/systems",
  "version": "1.0.0",
  "description": "Skipo Systems — Node graphs, tile menus, dock toolbars, infinite canvas, and Monaco editor",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node-graph": {
      "import": "./dist/node-graph/index.js",
      "types": "./dist/node-graph/index.d.ts"
    },
    "./tile-menu": {
      "import": "./dist/tile-menu/index.js",
      "types": "./dist/tile-menu/index.d.ts"
    },
    "./dock": {
      "import": "./dist/dock/index.js",
      "types": "./dist/dock/index.d.ts"
    },
    "./canvas": {
      "import": "./dist/canvas/index.js",
      "types": "./dist/canvas/index.d.ts"
    },
    "./editor": {
      "import": "./dist/editor/index.js",
      "types": "./dist/editor/index.d.ts"
    },
    "./audio-midi": {
      "import": "./dist/audio-midi/index.js",
      "types": "./dist/audio-midi/index.d.ts"
    },
    "./state": {
      "import": "./dist/state/index.js",
      "types": "./dist/state/index.d.ts"
    },
    "./execution": {
      "import": "./dist/execution/index.js",
      "types": "./dist/execution/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/node-graph/index.ts src/tile-menu/index.ts src/dock/index.ts src/canvas/index.ts src/editor/index.ts src/audio-midi/index.ts src/state/index.ts src/execution/index.ts --format esm --dts --clean --external react --external react-dom --external @dnd-kit/core --external @dnd-kit/sortable --external @dnd-kit/utilities --external monaco-editor",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@skipo/core": "workspace:*",
    "@skipo/ui": "workspace:*",
    "bullmq": "^6.3.8",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/sortable": "^8.0.0 || ^9.0.0",
    "@dnd-kit/utilities": "^3.0.0",
    "monaco-editor": "^0.50.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
