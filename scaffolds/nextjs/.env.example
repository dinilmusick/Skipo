# Canonical Skipo application environment
# Precedence: SYSTEM_DATABASE_URL (primary) > SYSTEM_DATABASE_URL_2 (fallback #1) > SYSTEM_DATABASE_URL_3 (fallback #2)
SYSTEM_DATABASE_URL="postgres://postgres:password@db1.region.example.com:5432/postgres?sslmode=require"
# SYSTEM_DATABASE_URL_2="postgres://postgres:password@db2.region.example.com:5432/postgres?sslmode=require"
# SYSTEM_DATABASE_URL_3="postgres://postgres:password@db3.region.example.com:5432/postgres?sslmode=require"
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Optional server-only OAuth settings for the Kloks Google Drive adapter.
# These values must be configured in the deployment secret store, not in browser code.
GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=replace-with-deployment-secret
GOOGLE_DRIVE_REDIRECT_URI=https://your-app.example/api/storage/google/callback
