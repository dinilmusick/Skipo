# SKIPO Canonical System Database Environment Variables
# Precedence: SYSTEM_DATABASE_URL (primary) > SYSTEM_DATABASE_URL_2 (fallback #1) > SYSTEM_DATABASE_URL_3 (fallback #2)
SYSTEM_DATABASE_URL="postgres://postgres:password@db1.region.example.com:5432/postgres?sslmode=require"
# SYSTEM_DATABASE_URL_2="postgres://postgres:password@db2.region.example.com:5432/postgres?sslmode=require"
# SYSTEM_DATABASE_URL_3="postgres://postgres:password@db3.region.example.com:5432/postgres?sslmode=require"
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Mandatory embedded Aiko module
AIKO_ENGINE_URL="https://<aiko-engine-host>"
# AIKO_MODULE_TOKEN="<configure-in-host-secret-store>"

# Canonical Luth authentication service
VITE_LUTH_URL="https://luth.blueprint-ninjastudios.workers.dev"
VITE_LUTH_ECOSYSTEM_ID="ultrst-armada"
VITE_LUTH_APPLICATION_ID="your-application-id"
