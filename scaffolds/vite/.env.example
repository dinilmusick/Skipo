# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run URL.
APP_URL="MY_APP_URL"

# ═══════════════════════════════════════════════
# SYSTEM DATABASE (Skipo Unified DB)
# Primary Neon Serverless connection string
SYSTEM_DATABASE_URL_1=
# Universal fallback (PostgreSQL, Supabase, Neon)
DATABASE_URL=
SYSTEM_DATABASE_URL_2=

# ═══════════════════════════════════════════════
# NODE ENV
NODE_ENV=development
