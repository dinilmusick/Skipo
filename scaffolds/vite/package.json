{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "skipo": {
    "deploy": "fullstack"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/skipo-build.mjs",
    "start": "node dist/providers/node/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist api",
    "lint": "node scripts/skipo-lint.mjs",
    "validate": "python3 Skipo/checklists/full_system_validator.py .",
    "validate:strict": "python3 Skipo/checklists/full_system_validator.py . --verbose",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/canonical-capabilities.test.cjs"
  },
  "dependencies": {
    "@dinilmusick/gutts": "2.2.3",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@ultrst-armada/floks": "2.0.10",
    "@ultrst-armada/frnlts": "0.5.26",
    "@ultrst-armada/kloks": "2.2.7",
    "@ultrst-armada/krnl": "1.0.27",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.1",
    "d3-force": "^3.0.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "zod": "^3.23.8",
    "zustand": "^5.0.15",
    "p-queue": "^10.0.0",
    "cactus-needle": "0.3.0",
    "@huggingface/transformers": "4.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "pnpm": {
    "overrides": {
      "@ultrst-armada/floks>@ultrst-armada/frnlts": "$@ultrst-armada/frnlts"
    },
    "onlyBuiltDependencies": [
      "@dinilmusick/gutts",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
