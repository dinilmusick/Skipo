{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "skipo": {
    "deploy": "fullstack"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:all",
    "build:fullstack": "node scripts/skipo-build.cjs fullstack",
    "build:api": "node scripts/skipo-build.cjs api",
    "build:all": "npm run build:fullstack && npm run build:api",
    "validate:api": "tsc --project tsconfig.api.json --noEmit",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
