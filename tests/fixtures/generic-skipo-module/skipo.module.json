{
  "$schema": "https://skipo.dev/schemas/module-v1.json",
  "contractVersion": "1.0.0",
  "module": { "id": "generic.inventory", "name": "Generic Inventory", "version": "1.0.0" },
  "application": { "framework": "skipo", "root": ".", "standalone": true, "moduleCapable": true, "execution": "both" },
  "api": { "baseRoute": "/api/inventory", "backendFacade": { "mode": "declared", "entry": "backend.ts", "consumes": ["workspace"] } },
  "capabilities": [{ "id": "inventory.list", "description": "List inventory items." }],
  "runtime": { "targets": ["node", "browser"], "requirements": [] },
  "resources": { "requires": [{ "id": "workspace", "kind": "workspace", "required": true }], "optional": [] },
  "ui": { "exports": [{ "id": "inventory.home", "entry": "frontend.ts", "kind": "page", "route": "/inventory" }] },
  "lifecycle": { "supported": ["validate", "initialize", "start", "stop", "dispose"] }
}
